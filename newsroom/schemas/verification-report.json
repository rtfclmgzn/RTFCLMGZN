{
  "type": "object",
  "properties": {
    "summary": {
      "type": "string"
    },
    "decision": {
      "type": "string",
      "enum": [
        "approve",
        "revise",
        "reject"
      ]
    },
    "verification_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "claim_id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "material": {
            "type": "boolean"
          },
          "status": {
            "type": "string",
            "enum": [
              "supported",
              "partially-supported",
              "unsupported",
              "contradicted",
              "uncertain"
            ]
          },
          "source_urls": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^https?://"
            }
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "notes": {
            "type": "string"
          }
        },
        "required": [
          "claim_id",
          "text",
          "material",
          "status",
          "source_urls",
          "confidence",
          "notes"
        ],
        "additionalProperties": false
      }
    },
    "unsupported_material_claims": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "contradictions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_count": {
      "type": "integer",
      "minimum": 0
    },
    "independent_source_count": {
      "type": "integer",
      "minimum": 0
    },
    "primary_source_count": {
      "type": "integer",
      "minimum": 0
    },
    "publishable": {
      "type": "boolean"
    }
  },
  "required": [
    "summary",
    "decision",
    "verification_score",
    "claims",
    "unsupported_material_claims",
    "contradictions",
    "source_count",
    "independent_source_count",
    "primary_source_count",
    "publishable"
  ],
  "additionalProperties": false
}
