{
  "type": "object",
  "properties": {
    "summary": {
      "type": "string"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "pattern": "^https?://"
          },
          "publisher": {
            "type": "string"
          },
          "source_class": {
            "type": "string",
            "enum": [
              "primary",
              "official",
              "credible-secondary",
              "analysis",
              "other"
            ]
          },
          "published_at": {
            "type": "string"
          },
          "supports": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "string"
          }
        },
        "required": [
          "label",
          "url",
          "publisher",
          "source_class",
          "published_at",
          "supports",
          "notes"
        ],
        "additionalProperties": false
      }
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          },
          "source_urls": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^https?://"
            }
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "is_primary_supported": {
            "type": "boolean"
          }
        },
        "required": [
          "text",
          "source_urls",
          "confidence",
          "is_primary_supported"
        ],
        "additionalProperties": false
      }
    },
    "contradictions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "source_urls": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^https?://"
            }
          }
        },
        "required": [
          "description",
          "source_urls"
        ],
        "additionalProperties": false
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "search_notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "publishable": {
      "type": "boolean"
    }
  },
  "required": [
    "summary",
    "sources",
    "facts",
    "contradictions",
    "open_questions",
    "search_notes",
    "publishable"
  ],
  "additionalProperties": false
}
