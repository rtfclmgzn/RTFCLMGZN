# RTFCLMGZN — Cloudflare Pages response headers
#
# The site remains protected against arbitrary framing. AutonoPress is the
# explicit exception so the public publication can be shown as a live proof
# preview on autonopress.com.
#
# Do not add X-Frame-Options here. The legacy header cannot express an
# allowlist for a different origin and would block the AutonoPress iframe.
# frame-ancestors in CSP is the authoritative framing policy.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=()
  Content-Security-Policy: default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'self' https://autonopress.com https://www.autonopress.com https://*.autonopress.com; script-src 'self' 'unsafe-inline' https://translate.google.com https://translate.googleapis.com https://translate-pa.googleapis.com https://www.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://www.gstatic.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: https://flagcdn.com https://translate.google.com https://translate.googleapis.com https://www.gstatic.com; connect-src 'self' https://translate.googleapis.com https://translate-pa.googleapis.com; frame-src 'self' https://translate.google.com https://translate.googleapis.com; form-action 'self'; manifest-src 'self'; worker-src 'self'; upgrade-insecure-requests
