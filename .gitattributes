# >>> RTFCLMGZN PLATFORM managed repository policy >>>
# Normalize source text consistently across Windows and Cloudflare/Linux
* text=auto
*.py text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.txt text eol=lf
*.bat text eol=crlf

# Binary assets must never be line-ending normalized
*.pdf -text
*.png -text
*.jpg -text
*.jpeg -text
*.gif -text
*.webp -text
*.avif -text
*.ico -text
*.mp3 -text
*.m4a -text
*.ogg -text
*.wav -text
*.zip -text
# <<< RTFCLMGZN PLATFORM managed repository policy <<<
